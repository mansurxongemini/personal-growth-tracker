// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Challenge {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  category    String    @default("Mind") // Health | Mind | Career | Finance | Social | Creativity | Fitness
  duration    Int       @default(21) // total days
  dailyTarget String    @default("") // e.g. "Read 20 pages", "Run 5km"
  color       String    @default("emerald") // accent color key
  icon        String    @default("Target")
  startDate   DateTime  @default(now())
  status      String    @default("active") // active | completed | failed | paused
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  logs        DailyLog[]
  notes       Note[]
}

model DailyLog {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  date        DateTime  // the calendar day this log belongs to (normalized to midnight)
  dayNumber   Int       // 1-based day index within the challenge
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([challengeId, date])
  @@index([challengeId])
}

model Note {
  id          String    @id @default(cuid())
  challengeId String?
  challenge   Challenge? @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  dailyLogId  String?
  title       String    @default("")
  content     String    @default("")
  mood        String    @default("neutral") // great | good | neutral | tough | bad
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// AI integration settings (context-aware multi-provider architecture).
/// Stored as a singleton (scope = "global") so the app works without auth.
/// When NextAuth is wired in, scope="user" + userId can scope per-user.
model AiSetting {
  id           String   @id @default(cuid())
  scope        String   @default("global") // global | user
  userId       String?  // null for global scope
  provider     String   @default("zai") // zai (in-house) | openai | anthropic | gemini | deepseek
  model        String   @default("glm-4.6") // e.g. glm-4.6, gpt-4o, claude-3-5-sonnet, deepseek-chat
  apiKey       String?  // user-supplied key (for external providers); null = use platform default
  systemPrompt String   @default("") // optional override; empty = use built-in assistant prompt
  temperature  Float    @default(0.7)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([scope, userId])
}

/// Persisted AI conversation messages so chat history survives reloads.
model AiMessage {
  id        String   @id @default(cuid())
  role      String // user | assistant | system
  content   String
  context   String  @default("") // snapshot of injected context (for debugging/audit)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

